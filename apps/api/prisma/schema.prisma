generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProductType {
  single
  booster_box
  collector_booster_box
  booster_box_18
  booster_bundle
  elite_trainer_box
  premium_booster_box
  extra_booster_box
  minifigure
}

enum Block {
  scarlet_and_violet
  sword_and_shield
  sun_and_moon
  x_y
  ex
  e_series
  web
  vs
  wotc
}

enum Franchise {
  mtg
  pokemon
  one_piece
  riftbound
  lego
}

enum Rarity {
  common
  uncommon
  rare
  land
  special_illustration_rare
  rainbow_rare
  promo
  holo_rare
}

enum FoilPattern {
  rareHolo
  reverse
  regularHolo
}

enum Region {
  japan
  korea
  taiwan_hong_kong
}

enum PriceType {
  cardmarket
  cardkingdom
  abugames
  buylist
  market
  ratio
  perBooster
  cardmarketListingCount
  fullSet
  tcgp
  bricklink
  bricklinkAverage
  cardmarketPsa1
  cardmarketPsa2
  cardmarketPsa3
  cardmarketPsa4
  cardmarketPsa5
  cardmarketPsa6
  cardmarketPsa7
  cardmarketPsa8
  cardmarketPsa9
  cardmarketPsa10
}

enum PerformancePeriodType {
  daily
  weekly
  monthly
  yearly
}

enum PerformanceType {
  market
  buylist
}

model Product {
  id                        String        @id @default(uuid())
  name                      String
  type                      ProductType
  boosterCount              Int?
  msrp                      Float?
  productSet                ProductSet           @relation(fields: [productSetId], references: [id])
  productSetId              String
  rarity                    Rarity?
  foilPattern               FoilPattern?
  tags                      String[]
  keyword                   String?
  blocked                   String[]

  imageUrl                  String?
  releaseDate               DateTime?

  note                      String?

  cardMarketLink            String?
  cardkingdomBuyListLink    String?
  abugamesBuyListLink       String?
  fullSetLink               String?
  tcgpLink                  String?
  bricklinkLink             String?
  psaLink                   String?
  number                    String?
  regions                   Region[]

  prices                    Price[]       @relation("ProductPrices")
  performances              Performance[] @relation("ProductPerformances")
  psaPopReport              PsaPopReport?

  collectionEntry           CollectionEntry?

  createdAt                 DateTime      @default(now())
  updatedAt                 DateTime      @updatedAt

  @@unique([name, productSetId, type, releaseDate, number])
}

model CollectionEntry {
  id          String    @id @default(uuid())
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId   String    @unique
  isOwned     Boolean   @default(false)
  isWanted    Boolean   @default(false)
  grade       Int?
  paidPrice   Float?
  acquiredAt  DateTime?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model ProductSet {
  id          String     @id @default(uuid())
  code        String
  name        String
  franchise   Franchise
  releaseDate DateTime
  block       Block?
  products    Product[]

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@unique([code, franchise])
}

model Price {
  id        String      @id @default(uuid())
  product   Product     @relation("ProductPrices", fields: [productId], references: [id], onDelete: Cascade)
  productId String
  date      DateTime
  value     Float?
  type      PriceType

  createdAt DateTime    @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([productId, date, type])
}

model Performance {
  id          String           @id @default(uuid())
  product     Product          @relation("ProductPerformances", fields: [productId], references: [id], onDelete: Cascade)
  productId   String
  date        DateTime
  value       Float?
  periodType  PerformancePeriodType
  type        PerformanceType

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([productId, date, periodType, type])
}

model PsaPopReport {
  id          String   @id @default(uuid())
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId   String   @unique
  grade1      Int?
  grade2      Int?
  grade3      Int?
  grade4      Int?
  grade5      Int?
  grade6      Int?
  grade7      Int?
  grade8      Int?
  grade9      Int?
  grade10     Int?
  total       Int?
  syncedAt    DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}