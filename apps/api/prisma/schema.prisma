generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Block {
  scarlet_and_violet
  sword_and_shield
  sun_and_moon
  x_y
  ex
  e_series
  web
  vs
  wotc
}

enum FoilPattern {
  rareHolo
  reverse
  regularHolo
}

enum Region {
  japan
  korea
  taiwan_hong_kong
}

enum PriceType {
  cardmarketPsa1
  cardmarketPsa2
  cardmarketPsa3
  cardmarketPsa4
  cardmarketPsa5
  cardmarketPsa6
  cardmarketPsa7
  cardmarketPsa8
  cardmarketPsa9
  cardmarketPsa10
}

enum Platform {
  ebay
}

enum SaleStatus {
  pending
  confirmed
  invalid
}

enum VerificationStage {
  unverified
  checked_7d
  complete
}

model Card {
  id                        String        @id @default(uuid())
  name                      String
  cardSet                   CardSet       @relation(fields: [cardSetId], references: [id])
  cardSetId                 String
  foilPattern               FoilPattern?
  tags                      String[]

  imageUrl                  String?
  releaseDate               DateTime?

  note                      String?

  cardMarketLink            String?
  psaLink                   String?
  ebayLink                  String?
  number                    String?
  regions                   Region[]

  prices                    Price[]       @relation("CardPrices")
  psaPopReport              PsaPopReport?
  sales                     Sale[]

  collectionEntry           CollectionEntry?

  createdAt                 DateTime      @default(now())
  updatedAt                 DateTime      @updatedAt

  @@unique([name, cardSetId, releaseDate, number])
}

model CollectionEntry {
  id          String    @id @default(uuid())
  card        Card      @relation(fields: [cardId], references: [id], onDelete: Cascade)
  cardId      String    @unique
  isOwned     Boolean   @default(false)
  isWanted    Boolean   @default(false)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model CardSet {
  id          String     @id @default(uuid())
  code        String
  name        String
  releaseDate DateTime
  block       Block?
  cards       Card[]

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@unique([code])
}

model Price {
  id        String      @id @default(uuid())
  card      Card        @relation("CardPrices", fields: [cardId], references: [id], onDelete: Cascade)
  cardId    String
  date      DateTime
  value     Float?
  type      PriceType

  createdAt DateTime    @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([cardId, date, type])
}

model Sale {
  id                String            @id @default(uuid())
  card              Card              @relation(fields: [cardId], references: [id], onDelete: Cascade)
  cardId            String
  platform          Platform
  itemId            String
  psaGrade          Int
  price             Float
  currency          String
  title             String
  isBestOffer       Boolean           @default(false)
  seller            String?
  status            SaleStatus        @default(pending)
  verificationStage VerificationStage @default(unverified)
  reviewedAt        DateTime?
  soldAt            DateTime

  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@unique([platform, itemId])
}

// eBay seller trust cache. Keyed by store slug (e.g. "psa").
// Populated on first encounter during a sale sync; avoids re-visiting the
// store page on every run. Re-check by deleting the row.
model Seller {
  id        String   @id @default(uuid())
  slug      String   @unique
  trusted   Boolean
  checkedAt DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PsaPopReport {
  id          String   @id @default(uuid())
  card        Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  cardId      String   @unique
  grade1      Int?
  grade2      Int?
  grade3      Int?
  grade4      Int?
  grade5      Int?
  grade6      Int?
  grade7      Int?
  grade8      Int?
  grade9      Int?
  grade10     Int?
  total       Int?
  syncedAt    DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}