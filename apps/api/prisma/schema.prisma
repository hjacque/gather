generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Block {
  scarlet_and_violet
  sword_and_shield
  sun_and_moon
  x_y
  ex
  e_series
  web
  vs
  wotc
}

enum FoilPattern {
  rareHolo
  reverse
  regularHolo
}

enum Region {
  japan
  korea
  taiwan_hong_kong
}

enum PriceType {
  marketSalePsa1
  marketSalePsa2
  marketSalePsa3
  marketSalePsa4
  marketSalePsa5
  marketSalePsa6
  marketSalePsa7
  marketSalePsa8
  marketSalePsa9
  marketSalePsa10
}

enum Platform {
  ebay
  cardmarket
}

enum SaleStatus {
  pending
  confirmed
  invalid
}

enum VerificationStage {
  unverified
  checked_7d
  complete
}

// Which scraper a Sale's price came from. `terapeak` is eBay's authoritative
// transaction price (accepted Best Offers included) but lags ~3 days; the public
// completed-listings search (`ebay_search`) is real-time but lists Best-Offer
// prices at the asking amount. The Sale upsert never lets an ebay_search price
// overwrite a terapeak one — see ADR 0008.
enum SaleSource {
  terapeak
  ebay_search
  terapeak_verified
}

model Card {
  id                        String        @id @default(uuid())
  name                      String
  cardSet                   CardSet       @relation(fields: [cardSetId], references: [id])
  cardSetId                 String
  foilPattern               FoilPattern?
  tags                      String[]

  imageUrl                  String?
  releaseDate               DateTime?

  note                      String?

  cardMarketLink            String?
  psaLink                   String?
  ebayLink                  String?
  ebayFrLink                String?
  number                    String?
  regions                   Region[]

  prices                    Price[]       @relation("CardPrices")
  psaPopReport              PsaPopReport?
  sales                     Sale[]
  listings                  Listing[]
  auctions                  Auction[]

  collectionEntry           CollectionEntry?

  createdAt                 DateTime      @default(now())
  updatedAt                 DateTime      @updatedAt

  @@unique([name, cardSetId, releaseDate, number])
}

model CollectionEntry {
  id          String    @id @default(uuid())
  card        Card      @relation(fields: [cardId], references: [id], onDelete: Cascade)
  cardId      String    @unique
  isOwned     Boolean   @default(false)
  isWanted    Boolean   @default(false)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model CardSet {
  id          String     @id @default(uuid())
  code        String
  name        String
  releaseDate DateTime
  block       Block?
  cards       Card[]

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@unique([code])
}

model Price {
  id        String      @id @default(uuid())
  card      Card        @relation("CardPrices", fields: [cardId], references: [id], onDelete: Cascade)
  cardId    String
  date      DateTime
  value     Float?
  type      PriceType

  createdAt DateTime    @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([cardId, date, type])
}

model Sale {
  id                String            @id @default(uuid())
  card              Card              @relation(fields: [cardId], references: [id], onDelete: Cascade)
  cardId            String
  platform          Platform
  itemId            String
  psaGrade          Int
  price             Float
  currency          String
  title             String
  isBestOffer       Boolean           @default(false)
  seller            String?
  status            SaleStatus        @default(pending)
  verificationStage VerificationStage @default(unverified)
  source            SaleSource        @default(terapeak)
  reviewedAt        DateTime?
  soldAt            DateTime

  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@unique([platform, itemId, cardId])
}

// An active marketplace ask (buyable now) — the buy-side complement of Sale.
// One row per live listing seen by the last Listings Sync; each sync fully
// replaces a card's rows, so disappeared listings are pruned automatically.
model Listing {
  id          String   @id @default(uuid())
  card        Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  cardId      String
  platform    Platform
  itemId      String
  psaGrade    Int
  price       Float
  currency    String
  title       String
  isBestOffer Boolean  @default(false)
  seller      String?
  // Verified-EU item location (e.g. "Allemagne") for eBay asks; null for
  // CardMarket and legacy rows scraped before location was captured.
  location    String?
  seenAt      DateTime
  // User-flagged as not matching this card: excluded from reads, but kept and
  // carried forward by itemId on re-sync so the flag survives full replacement.
  invalidatedAt DateTime?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([platform, itemId, cardId])
}

// An ongoing eBay auction (EU-located) for a Card at a PSA Grade. Separate from
// Listing on purpose (ADR 0010): the buy-side minimum reads only Listing, so an
// auction's currentBid is structurally incapable of feeding a Derived Price.
// Ephemeral — full per-card replacement on each Auction Sync, and rows are
// pruned/filtered out once endTime passes.
model Auction {
  id           String   @id @default(uuid())
  card         Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  cardId       String
  platform     Platform
  itemId       String
  psaGrade     Int
  // Current highest bid in its original currency — a moving asking price, never
  // a buyable one.
  currentBid   Float
  currency     String
  bidCount     Int      @default(0)
  // Absolute end instant, computed from eBay's relative "time left" caption at
  // scrape time. Immutable; drives the countdown and the endTime > now filter.
  endTime      DateTime
  title        String
  seller       String?
  // Verified-EU item location (e.g. "Allemagne"); null when no location line.
  location     String?
  // When currentBid + bidCount were last read (sync time or a later refresh).
  bidCheckedAt DateTime
  seenAt       DateTime
  // User-flagged as not matching this card: excluded from the feed, but kept and
  // carried forward by itemId on re-sync so the flag survives full replacement.
  invalidatedAt DateTime?
  // Set when the user corrects the scraped PSA grade; carried forward by itemId
  // so the re-sync's re-parsed grade doesn't clobber the manual fix.
  gradeEditedAt DateTime?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([platform, itemId, cardId])
  @@index([endTime])
}

model PsaPopReport {
  id          String   @id @default(uuid())
  card        Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  cardId      String   @unique
  grade1      Int?
  grade2      Int?
  grade3      Int?
  grade4      Int?
  grade5      Int?
  grade6      Int?
  grade7      Int?
  grade8      Int?
  grade9      Int?
  grade10     Int?
  total       Int?
  syncedAt    DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}